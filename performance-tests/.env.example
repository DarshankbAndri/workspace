# Include /api because the CMMS frontend proxies API requests through this path.
BASE_URL=http://localhost:6200/api
CMMS_USERNAME=superadmin
# Never commit the real password. Set CMMS_PASSWORD only in your terminal session.

# Required only when testing a non-local HTTP URL. HTTPS is strongly recommended.
ALLOW_INSECURE_HTTP=false

# smoke | baseline | load | stress | custom
PROFILE=smoke

# Used only by PROFILE=custom
VUS=10
DURATION=2m

# Optional output path. The reports directory is created by the wrapper scripts.
REPORT_PATH=reports/summary.json

