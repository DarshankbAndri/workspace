<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <!-- Add section_id column to telephone_entries -->
    <changeSet id="007-telephone-1" author="system">
        <addColumn tableName="telephone_entries">
            <column name="section_id" type="varchar(100)" remarks="Shared ID for grouping related documents"/>
        </addColumn>
    </changeSet>

    <!-- Create telephone_documents table -->
    <changeSet id="007-telephone-2" author="system">
        <createTable tableName="telephone_documents">
            <column name="id" type="bigserial" autoIncrement="true">
                <constraints primaryKey="true" primaryKeyName="pk_telephone_documents"/>
            </column>
            <column name="section_id" type="varchar(100)" remarks="Shared ID for grouping related documents">
                <constraints nullable="false"/>
            </column>
            <column name="telephone_entry_id" type="bigint" remarks="Reference to the telephone_entries">
                <constraints nullable="false"/>
            </column>
            <column name="document_name" type="varchar(255)" remarks="User-provided document name">
                <constraints nullable="false"/>
            </column>
            <column name="file_name" type="varchar(255)" remarks="Original file name">
                <constraints nullable="false"/>
            </column>
            <column name="file_path" type="varchar(500)" remarks="File path on disk">
                <constraints nullable="false"/>
            </column>
            <column name="uploaded_at" type="timestamp" remarks="Upload timestamp">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addForeignKeyConstraint baseTableName="telephone_documents" baseColumnNames="telephone_entry_id"
            referencedTableName="telephone_entries" referencedColumnNames="id"
            constraintName="fk_telephone_documents_entry"/>
        <createIndex tableName="telephone_documents" indexName="idx_telephone_documents_section_id">
            <column name="section_id"/>
        </createIndex>
        <createIndex tableName="telephone_documents" indexName="idx_telephone_documents_telephone_entry_id">
            <column name="telephone_entry_id"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>