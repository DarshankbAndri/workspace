<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="006-create-taxi-entries-table" author="admin">
        <createTable tableName="taxi_entries">
            <column name="id" type="BIGSERIAL">
                <constraints primaryKey="true"/>
            </column>
            <column name="claim_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="TEXT"/>
            <column name="amount" type="DECIMAL(10,2)"/>
            <column name="days" type="INT"/>
            <column name="total" type="DECIMAL(10,2)"/>
        </createTable>

        <addForeignKeyConstraint constraintName="fk_taxi_claim"
                                 baseTableName="taxi_entries"
                                 baseColumnNames="claim_id"
                                 referencedTableName="claims"
                                 referencedColumnNames="id"/>
        <createIndex indexName="idx_taxi_claim_id" tableName="taxi_entries">
            <column name="claim_id"/>
        </createIndex>
    </changeSet>

    <changeSet id="007-taxi-1" author="system">
        <addColumn tableName="taxi_entries">
            <column name="section_id" type="varchar(100)" remarks="Shared ID for grouping related documents"/>
        </addColumn>
    </changeSet>

</databaseChangeLog>