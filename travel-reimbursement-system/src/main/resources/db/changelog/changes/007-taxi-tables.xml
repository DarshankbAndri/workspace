<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <!-- Add section_id column to taxi_entries -->
    

    <!-- Create taxi_documents table -->
    <changeSet id="007-taxi-2" author="system">
        <createTable tableName="taxi_documents">
            <column name="id" type="bigserial" autoIncrement="true">
                <constraints primaryKey="true" primaryKeyName="pk_taxi_documents"/>
            </column>
            <column name="section_id" type="varchar(100)" remarks="Shared ID for grouping related documents">
                <constraints nullable="false"/>
            </column>
            <column name="taxi_entry_id" type="bigint" remarks="Reference to the taxi_entries">
                <constraints nullable="false"/>
            </column>
            <column name="document_name" type="varchar(255)" remarks="User-provided document name">
                <constraints nullable="false"/>
            </column>
            <column name="file_name" type="varchar(255)" remarks="Original file name">
                <constraints nullable="false"/>
            </column>
            <column name="file_path" type="varchar(500)" remarks="File path on disk">
                <constraints nullable="false"/>
            </column>
            <column name="uploaded_at" type="timestamp" remarks="Upload timestamp">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addForeignKeyConstraint baseTableName="taxi_documents" baseColumnNames="taxi_entry_id"
            referencedTableName="taxi_entries" referencedColumnNames="id"
            constraintName="fk_taxi_documents_entry"/>
        <createIndex tableName="taxi_documents" indexName="idx_taxi_documents_section_id">
            <column name="section_id"/>
        </createIndex>
        <createIndex tableName="taxi_documents" indexName="idx_taxi_documents_taxi_entry_id">
            <column name="taxi_entry_id"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>