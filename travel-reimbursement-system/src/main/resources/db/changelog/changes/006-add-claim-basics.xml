<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="006-add-claim-basics" author="admin">
        <addColumn tableName="claims">
            <column name="project_name" type="VARCHAR(255)"/>
            <column name="travel_purpose" type="VARCHAR(255)"/>
            <column name="travel_from_date" type="DATE"/>
            <column name="travel_from_time" type="TIME"/>
            <column name="travel_to_date" type="DATE"/>
            <column name="travel_to_time" type="TIME"/>
            <column name="from_location" type="VARCHAR(255)"/>
            <column name="to_location" type="VARCHAR(255)"/>
        </addColumn>
    </changeSet>

</databaseChangeLog>