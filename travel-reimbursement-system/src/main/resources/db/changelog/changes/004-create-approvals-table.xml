<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="004-create-approvals-table" author="admin">
        <createTable tableName="approvals">
            <column name="id" type="BIGSERIAL">
                <constraints primaryKey="true"/>
            </column>
            <column name="claim_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="approver_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="comments" type="TEXT"/>
            <column name="approved_at" type="TIMESTAMP" defaultValueDate="NOW()">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP" defaultValueDate="NOW()">
                <constraints nullable="false"/>
            </column>
            <column name="role" type="VARCHAR(50)" defaultValue="MANAGER">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="004-add-approvals-fk" author="admin">
        <addForeignKeyConstraint constraintName="fk_approvals_claim_id"
                                 baseTableName="approvals"
                                 baseColumnNames="claim_id"
                                 referencedTableName="claims"
                                 referencedColumnNames="id"/>
        <addForeignKeyConstraint constraintName="fk_approvals_approver_id"
                                 baseTableName="approvals"
                                 baseColumnNames="approver_id"
                                 referencedTableName="users"
                                 referencedColumnNames="id"/>
    </changeSet>

    <changeSet id="004-create-approvals-indexes" author="admin">
        <createIndex indexName="idx_approvals_claim_id" tableName="approvals">
            <column name="claim_id"/>
        </createIndex>
        <createIndex indexName="idx_approvals_approver_id" tableName="approvals">
            <column name="approver_id"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
