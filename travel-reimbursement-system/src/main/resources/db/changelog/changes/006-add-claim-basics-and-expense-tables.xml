<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="006-add-claim-basics-and-expense-tables" author="admin">
        <addColumn tableName="claims">
            <column name="project_name" type="VARCHAR(255)"/>
            <column name="travel_purpose" type="VARCHAR(255)"/>
            <column name="travel_from_date" type="DATE"/>
            <column name="travel_from_time" type="TIME"/>
            <column name="travel_to_date" type="DATE"/>
            <column name="travel_to_time" type="TIME"/>
            <column name="from_location" type="VARCHAR(255)"/>
            <column name="to_location" type="VARCHAR(255)"/>
        </addColumn>

        <createTable tableName="daily_summary_entries">
            <column name="id" type="BIGSERIAL">
                <constraints primaryKey="true"/>
            </column>
            <column name="claim_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="TEXT"/>
            <column name="amount" type="DECIMAL(10,2)"/>
            <column name="days" type="INT"/>
            <column name="total" type="DECIMAL(10,2)"/>
        </createTable>

        <createTable tableName="hotel_entries">
            <column name="id" type="BIGSERIAL">
                <constraints primaryKey="true"/>
            </column>
            <column name="claim_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="TEXT"/>
            <column name="amount" type="DECIMAL(10,2)"/>
            <column name="days" type="INT"/>
            <column name="total" type="DECIMAL(10,2)"/>
        </createTable>

        <createTable tableName="telephone_entries">
            <column name="id" type="BIGSERIAL">
                <constraints primaryKey="true"/>
            </column>
            <column name="claim_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="TEXT"/>
            <column name="amount" type="DECIMAL(10,2)"/>
            <column name="days" type="INT"/>
            <column name="total" type="DECIMAL(10,2)"/>
        </createTable>

        <createTable tableName="taxi_entries">
            <column name="id" type="BIGSERIAL">
                <constraints primaryKey="true"/>
            </column>
            <column name="claim_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="TEXT"/>
            <column name="amount" type="DECIMAL(10,2)"/>
            <column name="days" type="INT"/>
            <column name="total" type="DECIMAL(10,2)"/>
        </createTable>

        <createTable tableName="miscellaneous_entries">
            <column name="id" type="BIGSERIAL">
                <constraints primaryKey="true"/>
            </column>
            <column name="claim_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="TEXT"/>
            <column name="amount" type="DECIMAL(10,2)"/>
            <column name="days" type="INT"/>
            <column name="total" type="DECIMAL(10,2)"/>
        </createTable>

        <createTable tableName="other_expense_entries">
            <column name="id" type="BIGSERIAL">
                <constraints primaryKey="true"/>
            </column>
            <column name="claim_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="TEXT"/>
            <column name="amount" type="DECIMAL(10,2)"/>
            <column name="days" type="INT"/>
            <column name="total" type="DECIMAL(10,2)"/>
        </createTable>

        <addForeignKeyConstraint constraintName="fk_daily_summary_claim"
                                 baseTableName="daily_summary_entries"
                                 baseColumnNames="claim_id"
                                 referencedTableName="claims"
                                 referencedColumnNames="id"/>
        <addForeignKeyConstraint constraintName="fk_hotel_claim"
                                 baseTableName="hotel_entries"
                                 baseColumnNames="claim_id"
                                 referencedTableName="claims"
                                 referencedColumnNames="id"/>
        <addForeignKeyConstraint constraintName="fk_telephone_claim"
                                 baseTableName="telephone_entries"
                                 baseColumnNames="claim_id"
                                 referencedTableName="claims"
                                 referencedColumnNames="id"/>
        <addForeignKeyConstraint constraintName="fk_taxi_claim"
                                 baseTableName="taxi_entries"
                                 baseColumnNames="claim_id"
                                 referencedTableName="claims"
                                 referencedColumnNames="id"/>
        <addForeignKeyConstraint constraintName="fk_miscellaneous_claim"
                                 baseTableName="miscellaneous_entries"
                                 baseColumnNames="claim_id"
                                 referencedTableName="claims"
                                 referencedColumnNames="id"/>
        <addForeignKeyConstraint constraintName="fk_other_expense_claim"
                                 baseTableName="other_expense_entries"
                                 baseColumnNames="claim_id"
                                 referencedTableName="claims"
                                 referencedColumnNames="id"/>

        <createIndex indexName="idx_daily_summary_claim_id" tableName="daily_summary_entries">
            <column name="claim_id"/>
        </createIndex>
        <createIndex indexName="idx_hotel_claim_id" tableName="hotel_entries">
            <column name="claim_id"/>
        </createIndex>
        <createIndex indexName="idx_telephone_claim_id" tableName="telephone_entries">
            <column name="claim_id"/>
        </createIndex>
        <createIndex indexName="idx_taxi_claim_id" tableName="taxi_entries">
            <column name="claim_id"/>
        </createIndex>
        <createIndex indexName="idx_miscellaneous_claim_id" tableName="miscellaneous_entries">
            <column name="claim_id"/>
        </createIndex>
        <createIndex indexName="idx_other_expense_claim_id" tableName="other_expense_entries">
            <column name="claim_id"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
