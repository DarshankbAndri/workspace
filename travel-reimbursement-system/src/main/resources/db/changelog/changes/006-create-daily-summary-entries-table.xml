<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="006-create-daily-summary-entries-table" author="admin">
        <createTable tableName="daily_summary_entries">
            <column name="id" type="BIGSERIAL">
                <constraints primaryKey="true"/>
            </column>
            <column name="claim_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="TEXT"/>
            <column name="amount" type="DECIMAL(10,2)"/>
            <column name="days" type="INT"/>
            <column name="total" type="DECIMAL(10,2)"/>
        </createTable>

        <addForeignKeyConstraint constraintName="fk_daily_summary_claim"
                                 baseTableName="daily_summary_entries"
                                 baseColumnNames="claim_id"
                                 referencedTableName="claims"
                                 referencedColumnNames="id"/>
        <createIndex indexName="idx_daily_summary_claim_id" tableName="daily_summary_entries">
            <column name="claim_id"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>