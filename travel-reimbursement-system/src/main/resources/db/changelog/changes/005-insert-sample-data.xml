    <changeSet id="005-insert-claims" author="admin">
        <!-- Charlie's Claim 1: DRAFT -->
        <insert tableName="claims">
            <column name="user_id" valueNumeric="3"/>
            <column name="manager_id" valueNumeric="2"/>
            <column name="description" value="Business trip to New York for client meeting"/>
            <column name="amount" value="1500.00"/>
            <column name="status" value="DRAFT"/>
        </insert>

        <!-- Charlie's Claim 2: PENDING_MANAGER_APPROVAL -->
        <insert tableName="claims">
            <column name="user_id" valueNumeric="3"/>
            <column name="manager_id" valueNumeric="2"/>
            <column name="description" value="Flight and hotel for conference"/>
            <column name="amount" value="2500.00"/>
            <column name="status" value="PENDING_MANAGER_APPROVAL"/>
            <column name="submitted_at" valueDate="NOW()"/>
        </insert>

        <!-- David's Claim: MANAGER_APPROVED -->
        <insert tableName="claims">
            <column name="user_id" valueNumeric="4"/>
            <column name="manager_id" valueNumeric="2"/>
            <column name="description" value="Travel to Boston office"/>
            <column name="amount" value="800.00"/>
            <column name="status" value="MANAGER_APPROVED"/>
            <column name="submitted_at" valueDate="NOW()"/>
        </insert>

        <!-- Frank's Claim: MANAGER_APPROVED -->
        <insert tableName="claims">
            <column name="user_id" valueNumeric="6"/>
            <column name="manager_id" valueNumeric="5"/>
            <column name="description" value="Client dinner and travel expenses"/>
            <column name="amount" value="1200.00"/>
            <column name="status" value="MANAGER_APPROVED"/>
            <column name="submitted_at" valueDate="NOW()"/>
        </insert>
    </changeSet>

    <changeSet id="005-insert-approvals" author="admin">
        <!-- Bob (Manager) approves David's claim -->
        <insert tableName="approvals">
            <column name="claim_id" valueNumeric="3"/>
            <column name="approver_id" valueNumeric="2"/>
            <column name="status" value="APPROVED"/>
            <column name="comments" value="Approved by manager"/>
            <column name="approval_date" valueDate="NOW()"/>
        </insert>

        <!-- Emma (Manager) approves Frank's claim -->
        <insert tableName="approvals">
            <column name="claim_id" valueNumeric="4"/>
            <column name="approver_id" valueNumeric="5"/>
            <column name="status" value="APPROVED"/>
            <column name="comments" value="Approved by manager"/>
            <column name="approval_date" valueDate="NOW()"/>
        </insert>
    </changeSet>

</databaseChangeLog>
