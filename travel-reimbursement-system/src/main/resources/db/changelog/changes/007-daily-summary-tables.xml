<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <!-- Add section_id column to daily_summary_entries -->
    <changeSet id="007-daily-summary-1" author="system">
        <addColumn tableName="daily_summary_entries">
            <column name="section_id" type="varchar(100)" remarks="Shared ID for grouping related documents"/>
        </addColumn>
    </changeSet>

    <!-- Create daily_summary_documents table -->
    <changeSet id="007-daily-summary-2" author="system">
        <createTable tableName="daily_summary_documents">
            <column name="id" type="bigserial" autoIncrement="true">
                <constraints primaryKey="true" primaryKeyName="pk_daily_summary_documents"/>
            </column>
            <column name="section_id" type="varchar(100)" remarks="Shared ID for grouping related documents">
                <constraints nullable="false"/>
            </column>
            <column name="entry_id" type="bigint" remarks="Reference to the daily_summary_entries">
                <constraints nullable="false"/>
            </column>
            <column name="document_name" type="varchar(255)" remarks="User-provided document name">
                <constraints nullable="false"/>
            </column>
            <column name="file_name" type="varchar(255)" remarks="Original file name">
                <constraints nullable="false"/>
            </column>
            <column name="file_path" type="varchar(500)" remarks="File path on disk">
                <constraints nullable="false"/>
            </column>
            <column name="uploaded_at" type="timestamp" remarks="Upload timestamp">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addForeignKeyConstraint baseTableName="daily_summary_documents" baseColumnNames="entry_id"
            referencedTableName="daily_summary_entries" referencedColumnNames="id"
            constraintName="fk_daily_summary_documents_entry"/>
        <createIndex tableName="daily_summary_documents" indexName="idx_daily_summary_documents_section_id">
            <column name="section_id"/>
        </createIndex>
        <createIndex tableName="daily_summary_documents" indexName="idx_daily_summary_documents_entry_id">
            <column name="entry_id"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>