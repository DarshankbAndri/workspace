<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="equipment-downtime-001-create-table" author="DARSHAN">
        <createTable tableName="equipment_downtime">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="equipment_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="site_id" type="BIGINT"/>
            <column name="request_id" type="BIGINT"/>
            <column name="downtime_start" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="downtime_end" type="TIMESTAMP"/>
            <column name="downtime_minutes" type="BIGINT"/>
            <column name="reason" type="VARCHAR(120)">
                <constraints nullable="false"/>
            </column>
            <column name="planned" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="remarks" type="VARCHAR(1000)"/>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="equipment-downtime-002-add-foreign-keys" author="DARSHAN">
        <addForeignKeyConstraint constraintName="fk_downtime_equipment"
                                 baseTableName="equipment_downtime"
                                 baseColumnNames="equipment_id"
                                 referencedTableName="equipment_master"
                                 referencedColumnNames="id"/>
        <addForeignKeyConstraint constraintName="fk_downtime_request"
                                 baseTableName="equipment_downtime"
                                 baseColumnNames="request_id"
                                 referencedTableName="maintenance_request"
                                 referencedColumnNames="id"/>
        <addForeignKeyConstraint constraintName="fk_downtime_site"
                                 baseTableName="equipment_downtime"
                                 baseColumnNames="site_id"
                                 referencedTableName="site_master"
                                 referencedColumnNames="site_id"/>
    </changeSet>

    <changeSet id="equipment-downtime-003-create-indexes" author="DARSHAN">
        <createIndex indexName="idx_downtime_equipment" tableName="equipment_downtime">
            <column name="equipment_id"/>
        </createIndex>
        <createIndex indexName="idx_downtime_start" tableName="equipment_downtime">
            <column name="downtime_start"/>
        </createIndex>
        <createIndex indexName="idx_downtime_site_id" tableName="equipment_downtime">
            <column name="site_id"/>
        </createIndex>
    </changeSet>

    <changeSet id="equipment-downtime-004-production-rca-fields" author="Codex">
        <addColumn tableName="equipment_downtime">
            <column name="status" type="VARCHAR(30)" defaultValue="OPEN">
                <constraints nullable="false"/>
            </column>
            <column name="reason_category" type="VARCHAR(80)"/>
            <column name="reason_code" type="VARCHAR(80)"/>
            <column name="root_cause" type="VARCHAR(1000)"/>
            <column name="production_line" type="VARCHAR(120)"/>
            <column name="shift_name" type="VARCHAR(80)"/>
            <column name="operator_name" type="VARCHAR(120)"/>
            <column name="expected_output_per_hour" type="NUMERIC(14,2)"/>
            <column name="loss_rate_per_unit" type="NUMERIC(14,2)"/>
            <column name="lost_quantity" type="NUMERIC(14,2)"/>
            <column name="lost_amount" type="NUMERIC(14,2)"/>
            <column name="verified_by_user_id" type="BIGINT"/>
            <column name="verified_at" type="TIMESTAMP"/>
            <column name="closed_at" type="TIMESTAMP"/>
            <column name="closure_remarks" type="VARCHAR(1000)"/>
        </addColumn>
        <addForeignKeyConstraint constraintName="fk_downtime_verified_by_user"
                                 baseTableName="equipment_downtime"
                                 baseColumnNames="verified_by_user_id"
                                 referencedTableName="users"
                                 referencedColumnNames="id"/>
        <createIndex indexName="idx_downtime_status" tableName="equipment_downtime">
            <column name="status"/>
        </createIndex>
        <createIndex indexName="idx_downtime_reason_category" tableName="equipment_downtime">
            <column name="reason_category"/>
        </createIndex>
        <createIndex indexName="idx_downtime_closed_at" tableName="equipment_downtime">
            <column name="closed_at"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>
