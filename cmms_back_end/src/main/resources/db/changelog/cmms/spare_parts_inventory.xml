    <changeSet id="spare-parts-005-seed-role-permissions" author="DARSHAN">
        <sql>
            INSERT INTO role_permission (role_id, permission_id)
            SELECT r.role_id, p.permission_id
            FROM role_master r
            JOIN permission_master p ON p.module_name IN ('Spare Parts', 'Stock Transactions', 'Spare Usage', 'Reorder Requests')
            WHERE r.role_code IN ('SUPER_ADMIN', 'ADMIN')
            ON CONFLICT (role_id, permission_id) DO NOTHING;

            INSERT INTO role_permission (role_id, permission_id)
            SELECT r.role_id, p.permission_id
            FROM role_master r
            JOIN permission_master p ON p.permission_code IN (
                'SPARE_PART_VIEW', 'SPARE_PART_CREATE', 'SPARE_PART_UPDATE',
                'STOCK_TRANSACTION_VIEW', 'STOCK_TRANSACTION_CREATE',
                'SPARE_USAGE_VIEW', 'SPARE_USAGE_CREATE', 'SPARE_USAGE_UPDATE', 'SPARE_USAGE_DELETE',
                'REORDER_VIEW', 'REORDER_CREATE', 'REORDER_UPDATE',
                'SPARE_USAGE_RESERVE', 'SPARE_USAGE_ISSUE', 'SPARE_USAGE_CONSUME',
                'SPARE_USAGE_REJECT', 'SPARE_USAGE_CANCEL', 'SPARE_USAGE_RETURN',
                'SPARE_USAGE_MANAGER_APPROVE'
            )
            WHERE r.role_code IN ('SITE_MANAGER', 'MAINTENANCE_MANAGER')
            ON CONFLICT (role_id, permission_id) DO NOTHING;

            INSERT INTO role_permission (role_id, permission_id)
            SELECT r.role_id, p.permission_id
            FROM role_master r
            JOIN permission_master p ON p.permission_code IN ('SPARE_PART_VIEW', 'STOCK_TRANSACTION_VIEW', 'SPARE_USAGE_VIEW', 'SPARE_USAGE_CREATE', 'SPARE_USAGE_CONSUME', 'REORDER_VIEW')
            WHERE r.role_code = 'TECHNICIAN'
            ON CONFLICT (role_id, permission_id) DO NOTHING;

            INSERT INTO role_permission (role_id, permission_id)
            SELECT r.role_id, p.permission_id
            FROM role_master r
            JOIN permission_master p ON p.permission_code IN ('SPARE_PART_VIEW', 'STOCK_TRANSACTION_VIEW', 'SPARE_USAGE_VIEW', 'REORDER_VIEW')
            WHERE r.role_code = 'VIEWER'
            ON CONFLICT (role_id, permission_id) DO NOTHING;

            INSERT INTO role_permission (role_id, permission_id)
            SELECT r.role_id, p.permission_id
            FROM role_master r
            JOIN permission_master p ON p.permission_code IN (
                'SPARE_USAGE_STORE_PROCESS', 'SPARE_USAGE_RESERVE', 'SPARE_USAGE_ISSUE',
                'SPARE_USAGE_CONSUME', 'SPARE_USAGE_RETURN', 'REORDER_CREATE', 'REORDER_UPDATE',
                'STOCK_TRANSACTION_CREATE', 'STOCK_TRANSACTION_VIEW'
            )
            WHERE r.role_code IN ('SUPER_ADMIN', 'ADMIN', 'SITE_MANAGER')
            ON CONFLICT (role_id, permission_id) DO NOTHING;
        </sql>
    </changeSet>

    <changeSet id="spare-parts-006-seed-approval-config" author="DARSHAN">
        <sql>
            INSERT INTO approval_config (module_code, action_code, approval_required, approver_role_code, min_approval_count, status, created_at, updated_at) VALUES
            ('SPARE_ISSUE', 'RESERVE', false, 'MAINTENANCE_MANAGER', 1, 'ACTIVE', NOW(), NOW()),
            ('SPARE_ISSUE', 'ISSUE', false, 'MAINTENANCE_MANAGER', 1, 'ACTIVE', NOW(), NOW())
            ON CONFLICT (module_code, action_code) DO NOTHING;
        </sql>
