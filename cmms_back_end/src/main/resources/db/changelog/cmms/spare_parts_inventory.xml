<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="spare-part-001-create-table" author="DARSHAN">
        <createTable tableName="spare_part_master">
            <column name="spare_part_id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="part_code" type="VARCHAR(80)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="part_name" type="VARCHAR(180)">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="TEXT"/>
            <column name="category" type="VARCHAR(100)"/>
            <column name="unit" type="VARCHAR(30)">
                <constraints nullable="false"/>
            </column>
            <column name="preferred_vendor_id" type="BIGINT"/>
            <column name="status" type="VARCHAR(30)" defaultValue="ACTIVE">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="spare-part-site-stock-001-create-table" author="DARSHAN">
        <createTable tableName="spare_part_site_stock">
            <column name="stock_id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="spare_part_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="site_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="current_stock" type="DECIMAL(14,3)" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="reserved_stock" type="DECIMAL(14,3)" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="minimum_stock" type="DECIMAL(14,3)" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="unit_cost" type="DECIMAL(12,2)" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="storage_location" type="VARCHAR(150)"/>
            <column name="status" type="VARCHAR(30)" defaultValue="ACTIVE">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addUniqueConstraint tableName="spare_part_site_stock"
                             columnNames="spare_part_id, site_id"
                             constraintName="uk_spare_part_site_stock"/>
    </changeSet>

    <changeSet id="spare-part-transaction-001-create-table" author="DARSHAN">
        <createTable tableName="spare_part_transaction">
            <column name="transaction_id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="stock_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="spare_part_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="site_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="transaction_type" type="VARCHAR(40)">
                <constraints nullable="false"/>
            </column>
            <column name="quantity" type="DECIMAL(14,3)">
                <constraints nullable="false"/>
            </column>
            <column name="unit_cost" type="DECIMAL(12,2)" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="total_cost" type="DECIMAL(14,2)" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="stock_before" type="DECIMAL(14,3)">
                <constraints nullable="false"/>
            </column>
            <column name="stock_after" type="DECIMAL(14,3)">
                <constraints nullable="false"/>
            </column>
            <column name="reference_type" type="VARCHAR(80)"/>
            <column name="reference_id" type="BIGINT"/>
            <column name="remarks" type="VARCHAR(1000)"/>
            <column name="transaction_date" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="created_by" type="BIGINT"/>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="maintenance-spare-usage-001-create-table" author="DARSHAN">
        <createTable tableName="maintenance_spare_usage">
            <column name="usage_id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="assignment_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="stock_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="spare_part_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="quantity_used" type="DECIMAL(14,3)">
                <constraints nullable="false"/>
            </column>
            <column name="approved_qty" type="DECIMAL(14,3)"/>
            <column name="issued_qty" type="DECIMAL(14,3)" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="consumed_qty" type="DECIMAL(14,3)" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="returned_qty" type="DECIMAL(14,3)" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="unit_cost" type="DECIMAL(12,2)" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="total_cost" type="DECIMAL(14,2)" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="VARCHAR(30)" defaultValue="REQUESTED">
                <constraints nullable="false"/>
            </column>
            <column name="remarks" type="VARCHAR(1000)"/>
            <column name="requested_by" type="BIGINT"/>
            <column name="manager_approved_by" type="BIGINT"/>
            <column name="store_approved_by" type="BIGINT"/>
            <column name="reserved_by" type="BIGINT"/>
            <column name="issued_by" type="BIGINT"/>
            <column name="consumed_by" type="BIGINT"/>
            <column name="rejected_by" type="BIGINT"/>
            <column name="cancelled_by" type="BIGINT"/>
            <column name="requested_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP"/>
            <column name="reserved_at" type="TIMESTAMP"/>
            <column name="issued_at" type="TIMESTAMP"/>
            <column name="consumed_at" type="TIMESTAMP"/>
            <column name="rejected_at" type="TIMESTAMP"/>
            <column name="cancelled_at" type="TIMESTAMP"/>
            <column name="purchase_request_id" type="BIGINT"/>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addUniqueConstraint tableName="maintenance_spare_usage"
                             columnNames="assignment_id, stock_id"
                             constraintName="uk_assignment_spare_usage"/>
    </changeSet>

    <changeSet id="spare-part-reorder-request-001-create-table" author="DARSHAN">
        <createTable tableName="spare_part_reorder_request">
            <column name="reorder_id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="stock_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="spare_part_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="site_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="assignment_id" type="BIGINT"/>
            <column name="spare_request_id" type="BIGINT"/>
            <column name="vendor_id" type="BIGINT"/>
            <column name="requested_quantity" type="DECIMAL(14,3)">
                <constraints nullable="false"/>
            </column>
            <column name="estimated_unit_cost" type="DECIMAL(12,2)" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="estimated_total_cost" type="DECIMAL(14,2)" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="VARCHAR(30)" defaultValue="REQUESTED">
                <constraints nullable="false"/>
            </column>
            <column name="expected_date" type="DATE"/>
            <column name="remarks" type="VARCHAR(1000)"/>
            <column name="requested_by" type="BIGINT"/>
            <column name="requested_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

