<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="cmms-maintenance-request-create" author="darshan">
        <preConditions onFail="MARK_RAN">
            <not><tableExists tableName="maintenance_request"/></not>
        </preConditions>
        <createTable tableName="maintenance_request">
            <column name="id" type="BIGSERIAL"><constraints primaryKey="true"/></column>
            <column name="request_number" type="VARCHAR(60)"><constraints nullable="false" unique="true"/></column>
            <column name="equipment_id" type="BIGINT"><constraints nullable="false"/></column>
            <column name="request_type" type="VARCHAR(40)" defaultValue="BREAKDOWN"><constraints nullable="false"/></column>
            <column name="priority" type="VARCHAR(30)" defaultValue="MEDIUM"><constraints nullable="false"/></column>
            <column name="status" type="VARCHAR(30)" defaultValue="OPEN"><constraints nullable="false"/></column>
            <column name="title" type="VARCHAR(200)"><constraints nullable="false"/></column>
            <column name="description" type="VARCHAR(1000)"><constraints nullable="false"/></column>
            <column name="reported_by" type="VARCHAR(120)"/>
            <column name="requested_date" type="DATE"><constraints nullable="false"/></column>
            <column name="target_completion_date" type="DATE"/>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP"><constraints nullable="false"/></column>
            <column name="updated_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP"><constraints nullable="false"/></column>
        </createTable>
    </changeSet>

    <changeSet id="cmms-maintenance-request-add-site" author="codex">
        <preConditions onFail="MARK_RAN">
            <not><columnExists tableName="maintenance_request" columnName="site_id"/></not>
        </preConditions>
        <addColumn tableName="maintenance_request">
            <column name="site_id" type="BIGINT"/>
        </addColumn>
    </changeSet>

    <changeSet id="cmms-maintenance-request-add-pm-schedule" author="darshan">
        <preConditions onFail="MARK_RAN">
            <not><columnExists tableName="maintenance_request" columnName="pm_schedule_id"/></not>
        </preConditions>
        <addColumn tableName="maintenance_request">
            <column name="pm_schedule_id" type="BIGINT"/>
        </addColumn>
    </changeSet>

    <changeSet id="cmms-maintenance-request-fks" author="darshan">
        <preConditions onFail="MARK_RAN">
            <not><foreignKeyConstraintExists foreignKeyName="fk_request_equipment" foreignKeyTableName="maintenance_request"/></not>
        </preConditions>
        <addForeignKeyConstraint constraintName="fk_request_equipment" baseTableName="maintenance_request" baseColumnNames="equipment_id" referencedTableName="equipment_master" referencedColumnNames="id"/>
        <addForeignKeyConstraint constraintName="fk_request_site" baseTableName="maintenance_request" baseColumnNames="site_id" referencedTableName="site_master" referencedColumnNames="site_id"/>
        <addForeignKeyConstraint constraintName="fk_request_pm_schedule" baseTableName="maintenance_request" baseColumnNames="pm_schedule_id" referencedTableName="preventive_maintenance_schedule" referencedColumnNames="id"/>
    </changeSet>

    <changeSet id="cmms-maintenance-request-indexes" author="darshan">
        <preConditions onFail="MARK_RAN">
            <not><indexExists indexName="idx_request_equipment"/></not>
        </preConditions>
        <createIndex indexName="idx_request_equipment" tableName="maintenance_request"><column name="equipment_id"/></createIndex>
        <createIndex indexName="idx_request_status" tableName="maintenance_request"><column name="status"/></createIndex>
        <createIndex indexName="idx_request_site_id" tableName="maintenance_request"><column name="site_id"/></createIndex>
        <createIndex indexName="idx_request_pm_schedule" tableName="maintenance_request"><column name="pm_schedule_id"/></createIndex>
    </changeSet>
</databaseChangeLog>
