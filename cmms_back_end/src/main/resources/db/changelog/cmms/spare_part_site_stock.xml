<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd" xmlns="http://www.liquibase.org/xml/ns/dbchangelog">
    <changeSet id="spare-part-site-stock-001-create-table" author="DARSHAN">
        <createTable tableName="spare_part_site_stock">
            <column name="stock_id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false" />
            </column>
            <column name="spare_part_id" type="BIGINT">
                <constraints nullable="false" />
            </column>
            <column name="site_id" type="BIGINT">
                <constraints nullable="false" />
            </column>
            <column name="current_stock" type="DECIMAL(14,3)" defaultValueNumeric="0">
                <constraints nullable="false" />
            </column>
            <column name="reserved_stock" type="DECIMAL(14,3)" defaultValueNumeric="0">
                <constraints nullable="false" />
            </column>
            <column name="minimum_stock" type="DECIMAL(14,3)" defaultValueNumeric="0">
                <constraints nullable="false" />
            </column>
            <column name="unit_cost" type="DECIMAL(12,2)" defaultValueNumeric="0">
                <constraints nullable="false" />
            </column>
            <column name="storage_location" type="VARCHAR(150)" />
            <column name="status" type="VARCHAR(30)" defaultValue="ACTIVE">
                <constraints nullable="false" />
            </column>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false" />
            </column>
            <column name="updated_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false" />
            </column>
        </createTable>
        <addUniqueConstraint tableName="spare_part_site_stock" columnNames="spare_part_id, site_id" constraintName="uk_spare_part_site_stock" />
    </changeSet>
    <changeSet id="spare-part-site-stock-002-add-foreign-keys" author="DARSHAN">
        <addForeignKeyConstraint constraintName="fk_spare_stock_part" baseTableName="spare_part_site_stock" baseColumnNames="spare_part_id" referencedTableName="spare_part_master" referencedColumnNames="spare_part_id" />
        <addForeignKeyConstraint constraintName="fk_spare_stock_site" baseTableName="spare_part_site_stock" baseColumnNames="site_id" referencedTableName="site_master" referencedColumnNames="site_id" />
    </changeSet>
    <changeSet id="spare-part-site-stock-003-create-indexes" author="DARSHAN">
        <createIndex indexName="idx_spare_stock_site_status" tableName="spare_part_site_stock">
            <column name="site_id" />
            <column name="status" />
        </createIndex>
        <createIndex indexName="idx_spare_stock_part" tableName="spare_part_site_stock">
            <column name="spare_part_id" />
        </createIndex>
        <createIndex indexName="idx_spare_stock_low" tableName="spare_part_site_stock">
            <column name="site_id" />
            <column name="current_stock" />
            <column name="minimum_stock" />
        </createIndex>
    </changeSet>
</databaseChangeLog>