<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd" xmlns="http://www.liquibase.org/xml/ns/dbchangelog">
    <changeSet id="spare-part-transaction-001-create-table" author="DARSHAN">
        <createTable tableName="spare_part_transaction">
            <column name="transaction_id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false" />
            </column>
            <column name="stock_id" type="BIGINT">
                <constraints nullable="false" />
            </column>
            <column name="spare_part_id" type="BIGINT">
                <constraints nullable="false" />
            </column>
            <column name="site_id" type="BIGINT">
                <constraints nullable="false" />
            </column>
            <column name="transaction_type" type="VARCHAR(40)">
                <constraints nullable="false" />
            </column>
            <column name="quantity" type="DECIMAL(14,3)">
                <constraints nullable="false" />
            </column>
            <column name="unit_cost" type="DECIMAL(12,2)" defaultValueNumeric="0">
                <constraints nullable="false" />
            </column>
            <column name="total_cost" type="DECIMAL(14,2)" defaultValueNumeric="0">
                <constraints nullable="false" />
            </column>
            <column name="stock_before" type="DECIMAL(14,3)">
                <constraints nullable="false" />
            </column>
            <column name="stock_after" type="DECIMAL(14,3)">
                <constraints nullable="false" />
            </column>
            <column name="reference_type" type="VARCHAR(80)" />
            <column name="reference_id" type="BIGINT" />
            <column name="remarks" type="VARCHAR(1000)" />
            <column name="transaction_date" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false" />
            </column>
            <column name="created_by" type="BIGINT" />
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false" />
            </column>
        </createTable>
    </changeSet>
    <changeSet id="spare-part-transaction-002-add-foreign-keys" author="DARSHAN">
        <addForeignKeyConstraint constraintName="fk_spare_tx_stock" baseTableName="spare_part_transaction" baseColumnNames="stock_id" referencedTableName="spare_part_site_stock" referencedColumnNames="stock_id" />
        <addForeignKeyConstraint constraintName="fk_spare_tx_part" baseTableName="spare_part_transaction" baseColumnNames="spare_part_id" referencedTableName="spare_part_master" referencedColumnNames="spare_part_id" />
        <addForeignKeyConstraint constraintName="fk_spare_tx_site" baseTableName="spare_part_transaction" baseColumnNames="site_id" referencedTableName="site_master" referencedColumnNames="site_id" />
        <addForeignKeyConstraint constraintName="fk_spare_tx_created_by" baseTableName="spare_part_transaction" baseColumnNames="created_by" referencedTableName="users" referencedColumnNames="id" />
    </changeSet>
    <changeSet id="spare-part-transaction-003-create-indexes" author="DARSHAN">
        <createIndex indexName="idx_spare_tx_stock_date" tableName="spare_part_transaction">
            <column name="stock_id" />
            <column name="transaction_date" />
        </createIndex>
        <createIndex indexName="idx_spare_tx_site_date" tableName="spare_part_transaction">
            <column name="site_id" />
            <column name="transaction_date" />
        </createIndex>
    </changeSet>
</databaseChangeLog>