<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd" xmlns="http://www.liquibase.org/xml/ns/dbchangelog">
    <changeSet id="notification-setting-001-create-table" author="DARSHAN">
        <createTable tableName="notification_setting">
            <column name="setting_id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false" />
            </column>
            <column name="enabled" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false" />
            </column>
            <column name="in_app_enabled" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false" />
            </column>
            <column name="email_enabled" type="BOOLEAN" defaultValueBoolean="false" />
            <column name="pm_due_reminder_enabled" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false" />
            </column>
            <column name="overdue_request_enabled" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false" />
            </column>
            <column name="approval_pending_enabled" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false" />
            </column>
            <column name="pm_reminder_days" type="INTEGER" defaultValueNumeric="3">
                <constraints nullable="false" />
            </column>
            <column name="scan_cron" type="VARCHAR(120)" defaultValue="0 0 7 * * *">
                <constraints nullable="false" />
            </column>
            <column name="pm_recipient_role_codes" type="VARCHAR(1000)" />
            <column name="overdue_recipient_role_codes" type="VARCHAR(1000)" />
            <column name="approval_fallback_role_codes" type="VARCHAR(1000)" />
            <column name="updated_by" type="BIGINT" />
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false" />
            </column>
            <column name="updated_at" type="TIMESTAMP" />
        </createTable>
    </changeSet>
    <changeSet id="notification-setting-002-add-foreign-keys" author="DARSHAN">
        <addForeignKeyConstraint constraintName="fk_notification_setting_updated_by" baseTableName="notification_setting" baseColumnNames="updated_by" referencedTableName="users" referencedColumnNames="id" />
    </changeSet>
    <changeSet id="notification-setting-003-seed-permissions" author="DARSHAN">
        <sql>
            INSERT INTO permission_master (permission_code, permission_name, module_name, action_name, status, created_at, updated_at) VALUES
            ('NOTIFICATION_CONFIG_VIEW', 'View Notification Settings', 'Notification Settings', 'VIEW', 'ACTIVE', NOW(), NOW()),
            ('NOTIFICATION_CONFIG_UPDATE', 'Update Notification Settings', 'Notification Settings', 'UPDATE', 'ACTIVE', NOW(), NOW())
            ON CONFLICT (permission_code) DO NOTHING;
        </sql>
    </changeSet>
</databaseChangeLog>