<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">
    <changeSet id="equipment_checklist-create" author="Codex">
        <createTable tableName="equipment_checklist">
            <column name="id" type="BIGINT" autoIncrement="true"><constraints nullable="false" primaryKey="true"/></column>
            <column name="equipment_id" type="BIGINT"><constraints nullable="false"/></column>
            <column name="name" type="VARCHAR(200)"><constraints nullable="false"/></column>
            <column name="active" type="BOOLEAN"><constraints nullable="false"/></column>
        </createTable>
        <addForeignKeyConstraint constraintName="fk_equipment_checklist_equipment_id" baseTableName="equipment_checklist" baseColumnNames="equipment_id" referencedTableName="equipment_master" referencedColumnNames="id"/>
        <createIndex indexName="idx_equipment_checklist_equipment_id" tableName="equipment_checklist"><column name="equipment_id"/></createIndex>
    </changeSet>
</databaseChangeLog>
