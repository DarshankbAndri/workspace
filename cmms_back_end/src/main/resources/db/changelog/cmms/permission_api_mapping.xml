<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="permission-api-mapping-001-create-table" author="Codex">
        <createTable tableName="permission_api_mapping">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="permission_code" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="api_path" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="http_method" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="VARCHAR(500)"/>
            <column name="active" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="permission-api-mapping-002-constraints-indexes" author="Codex">
        <addUniqueConstraint tableName="permission_api_mapping"
                             columnNames="permission_code, api_path, http_method"
                             constraintName="uk_permission_api_mapping"/>
        <createIndex indexName="idx_permission_api_mapping_code" tableName="permission_api_mapping">
            <column name="permission_code"/>
        </createIndex>
        <createIndex indexName="idx_permission_api_mapping_path" tableName="permission_api_mapping">
            <column name="api_path"/>
        </createIndex>
        <createIndex indexName="idx_permission_api_mapping_method" tableName="permission_api_mapping">
            <column name="http_method"/>
        </createIndex>
        <createIndex indexName="idx_permission_api_mapping_active" tableName="permission_api_mapping">
            <column name="active"/>
        </createIndex>
    </changeSet>

    <changeSet id="permission-api-mapping-003-add-permission-code-fk" author="Codex">
        <addForeignKeyConstraint baseTableName="permission_api_mapping"
                                 baseColumnNames="permission_code"
                                 referencedTableName="permission_master"
                                 referencedColumnNames="permission_code"
                                 constraintName="fk_permission_api_mapping_permission_code"/>
    </changeSet>
</databaseChangeLog>
