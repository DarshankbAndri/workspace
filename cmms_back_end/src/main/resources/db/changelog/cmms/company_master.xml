<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="cmms-company-master-create" author="DARSHAN">
        <createTable tableName="company_master">
            <column name="id" type="BIGINT" autoIncrement="true"><constraints primaryKey="true"/></column>
            <column name="company_name" type="VARCHAR(150)"><constraints nullable="false"/></column>
            <column name="company_code" type="VARCHAR(50)"><constraints nullable="false" unique="true"/></column>
            <column name="email" type="VARCHAR(150)"/>
            <column name="phone_number" type="VARCHAR(30)"/>
            <column name="address" type="VARCHAR(500)"/>
            <column name="logo_path" type="VARCHAR(500)"/>
            <column name="logo_url" type="VARCHAR(500)"/>
            <column name="status" type="VARCHAR(20)" defaultValue="ACTIVE"><constraints nullable="false"/></column>
            <column name="created_date" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP"><constraints nullable="false"/></column>
            <column name="updated_date" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP"><constraints nullable="false"/></column>
        </createTable>
    </changeSet>

    <changeSet id="cmms-company-master-indexes" author="DARSHAN">
        <createIndex indexName="idx_company_master_status" tableName="company_master"><column name="status"/></createIndex>
        <createIndex indexName="idx_company_master_updated" tableName="company_master"><column name="updated_date"/></createIndex>
    </changeSet>

    <changeSet id="cmms-company-master-permissions" author="DARSHAN">
        <sql>
            INSERT INTO permission_master (permission_code, permission_name, module_name, action_name, status, created_at, updated_at) VALUES
            ('COMPANY_VIEW', 'View Company Master', 'Company', 'VIEW', 'ACTIVE', NOW(), NOW()),
            ('COMPANY_CREATE', 'Create Company Master', 'Company', 'CREATE', 'ACTIVE', NOW(), NOW()),
            ('COMPANY_UPDATE', 'Update Company Master', 'Company', 'UPDATE', 'ACTIVE', NOW(), NOW())
            ON CONFLICT (permission_code) DO NOTHING;
        </sql>
    </changeSet>
</databaseChangeLog>
