<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd" xmlns="http://www.liquibase.org/xml/ns/dbchangelog">
    <changeSet id="maintenance-spare-usage-001-create-table" author="DARSHAN">
        <createTable tableName="maintenance_spare_usage">
            <column name="usage_id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false" />
            </column>
            <column name="assignment_id" type="BIGINT">
                <constraints nullable="false" />
            </column>
            <column name="stock_id" type="BIGINT">
                <constraints nullable="false" />
            </column>
            <column name="spare_part_id" type="BIGINT">
                <constraints nullable="false" />
            </column>
            <column name="quantity_used" type="DECIMAL(14,3)">
                <constraints nullable="false" />
            </column>
            <column name="approved_qty" type="DECIMAL(14,3)" />
            <column name="issued_qty" type="DECIMAL(14,3)" defaultValueNumeric="0">
                <constraints nullable="false" />
            </column>
            <column name="consumed_qty" type="DECIMAL(14,3)" defaultValueNumeric="0">
                <constraints nullable="false" />
            </column>
            <column name="returned_qty" type="DECIMAL(14,3)" defaultValueNumeric="0">
                <constraints nullable="false" />
            </column>
            <column name="unit_cost" type="DECIMAL(12,2)" defaultValueNumeric="0">
                <constraints nullable="false" />
            </column>
            <column name="total_cost" type="DECIMAL(14,2)" defaultValueNumeric="0">
                <constraints nullable="false" />
            </column>
            <column name="status" type="VARCHAR(30)" defaultValue="REQUESTED">
                <constraints nullable="false" />
            </column>
            <column name="remarks" type="VARCHAR(1000)" />
            <column name="requested_by" type="BIGINT" />
            <column name="manager_approved_by" type="BIGINT" />
            <column name="store_approved_by" type="BIGINT" />
            <column name="reserved_by" type="BIGINT" />
            <column name="issued_by" type="BIGINT" />
            <column name="consumed_by" type="BIGINT" />
            <column name="rejected_by" type="BIGINT" />
            <column name="cancelled_by" type="BIGINT" />
            <column name="requested_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP" />
            <column name="reserved_at" type="TIMESTAMP" />
            <column name="issued_at" type="TIMESTAMP" />
            <column name="consumed_at" type="TIMESTAMP" />
            <column name="rejected_at" type="TIMESTAMP" />
            <column name="cancelled_at" type="TIMESTAMP" />
            <column name="purchase_request_id" type="BIGINT" />
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false" />
            </column>
            <column name="updated_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false" />
            </column>
        </createTable>
        <addUniqueConstraint tableName="maintenance_spare_usage" columnNames="assignment_id, stock_id" constraintName="uk_assignment_spare_usage" />
    </changeSet>
    <changeSet id="maintenance-spare-usage-002-add-foreign-keys" author="DARSHAN">
        <addForeignKeyConstraint constraintName="fk_spare_usage_assignment" baseTableName="maintenance_spare_usage" baseColumnNames="assignment_id" referencedTableName="maintenance_assignment" referencedColumnNames="id" />
        <addForeignKeyConstraint constraintName="fk_spare_usage_stock" baseTableName="maintenance_spare_usage" baseColumnNames="stock_id" referencedTableName="spare_part_site_stock" referencedColumnNames="stock_id" />
        <addForeignKeyConstraint constraintName="fk_spare_usage_part" baseTableName="maintenance_spare_usage" baseColumnNames="spare_part_id" referencedTableName="spare_part_master" referencedColumnNames="spare_part_id" />
        <addForeignKeyConstraint constraintName="fk_spare_usage_requested_by" baseTableName="maintenance_spare_usage" baseColumnNames="requested_by" referencedTableName="users" referencedColumnNames="id" />
        <addForeignKeyConstraint constraintName="fk_spare_usage_manager_approved_by" baseTableName="maintenance_spare_usage" baseColumnNames="manager_approved_by" referencedTableName="users" referencedColumnNames="id" />
        <addForeignKeyConstraint constraintName="fk_spare_usage_store_approved_by" baseTableName="maintenance_spare_usage" baseColumnNames="store_approved_by" referencedTableName="users" referencedColumnNames="id" />
        <addForeignKeyConstraint constraintName="fk_spare_usage_reserved_by" baseTableName="maintenance_spare_usage" baseColumnNames="reserved_by" referencedTableName="users" referencedColumnNames="id" />
        <addForeignKeyConstraint constraintName="fk_spare_usage_issued_by" baseTableName="maintenance_spare_usage" baseColumnNames="issued_by" referencedTableName="users" referencedColumnNames="id" />
        <addForeignKeyConstraint constraintName="fk_spare_usage_consumed_by" baseTableName="maintenance_spare_usage" baseColumnNames="consumed_by" referencedTableName="users" referencedColumnNames="id" />
        <addForeignKeyConstraint constraintName="fk_spare_usage_rejected_by" baseTableName="maintenance_spare_usage" baseColumnNames="rejected_by" referencedTableName="users" referencedColumnNames="id" />
        <addForeignKeyConstraint constraintName="fk_spare_usage_cancelled_by" baseTableName="maintenance_spare_usage" baseColumnNames="cancelled_by" referencedTableName="users" referencedColumnNames="id" />
    </changeSet>
    <changeSet id="maintenance-spare-usage-003-create-indexes" author="DARSHAN">
        <createIndex indexName="idx_maintenance_spare_assignment" tableName="maintenance_spare_usage">
            <column name="assignment_id" />
        </createIndex>
        <createIndex indexName="idx_maintenance_spare_part" tableName="maintenance_spare_usage">
            <column name="spare_part_id" />
        </createIndex>
        <createIndex indexName="idx_maintenance_spare_status" tableName="maintenance_spare_usage">
            <column name="status" />
        </createIndex>
        <createIndex indexName="idx_spare_usage_purchase_request" tableName="maintenance_spare_usage">
            <column name="purchase_request_id" />
        </createIndex>
    </changeSet>
    <changeSet id="maintenance-spare-usage-004-add-reorder-foreign-key" author="DARSHAN" runOrder="last">
        <addForeignKeyConstraint constraintName="fk_spare_usage_purchase_request" baseTableName="maintenance_spare_usage" baseColumnNames="purchase_request_id" referencedTableName="spare_part_reorder_request" referencedColumnNames="reorder_id" />
    </changeSet>
</databaseChangeLog>