<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="cmms-maintenance-assignment-create" author="DARSHAN">
        <createTable tableName="maintenance_assignment">
            <column name="id" type="BIGINT" autoIncrement="true"><constraints primaryKey="true"/></column>
            <column name="request_id" type="BIGINT"><constraints nullable="false"/></column>
            <column name="vendor_id" type="BIGINT"/>
            <column name="assigned_to" type="VARCHAR(120)"><constraints nullable="false"/></column>
            <column name="assigned_date" type="DATE"><constraints nullable="false"/></column>
            <column name="planned_start_date" type="DATE"/>
            <column name="planned_end_date" type="DATE"/>
            <column name="actual_start_date" type="DATE"/>
            <column name="actual_end_date" type="DATE"/>
            <column name="status" type="VARCHAR(30)" defaultValue="ASSIGNED"><constraints nullable="false"/></column>
            <column name="estimated_cost" type="NUMERIC(12,2)"/>
            <column name="actual_cost" type="NUMERIC(12,2)"/>
            <column name="remarks" type="VARCHAR(1000)"/>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP"><constraints nullable="false"/></column>
            <column name="updated_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP"><constraints nullable="false"/></column>
        </createTable>
    </changeSet>

    <changeSet id="cmms-maintenance-assignment-fks" author="DARSHAN">
        <addForeignKeyConstraint constraintName="fk_assignment_request" baseTableName="maintenance_assignment" baseColumnNames="request_id" referencedTableName="maintenance_request" referencedColumnNames="id"/>
        <addForeignKeyConstraint constraintName="fk_assignment_vendor" baseTableName="maintenance_assignment" baseColumnNames="vendor_id" referencedTableName="vendor_master" referencedColumnNames="id"/>
    </changeSet>

    <changeSet id="cmms-maintenance-assignment-indexes" author="DARSHAN">
        <createIndex indexName="idx_assignment_request" tableName="maintenance_assignment"><column name="request_id"/></createIndex>
    </changeSet>
    <changeSet id="3" author="DARSHAN">
        <addColumn tableName="maintenance_assignment">
            <column name="assigned_employee_id" type="BIGINT"/>
        </addColumn>
        <addForeignKeyConstraint constraintName="fk_assignment_employee" baseTableName="maintenance_assignment" baseColumnNames="assigned_employee_id" referencedTableName="employee_master" referencedColumnNames="employee_id"/>
        <createIndex indexName="idx_assignment_employee" tableName="maintenance_assignment"><column name="assigned_employee_id"/></createIndex>
    </changeSet>
</databaseChangeLog>
