<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="cmms-equipment-master-create" author="codex">
        <preConditions onFail="MARK_RAN">
            <not><tableExists tableName="equipment_master"/></not>
        </preConditions>
        <createTable tableName="equipment_master">
            <column name="id" type="BIGSERIAL"><constraints primaryKey="true"/></column>
            <column name="equipment_code" type="VARCHAR(50)"><constraints nullable="false" unique="true"/></column>
            <column name="equipment_name" type="VARCHAR(150)"><constraints nullable="false"/></column>
            <column name="category" type="VARCHAR(100)"><constraints nullable="false"/></column>
            <column name="location" type="VARCHAR(100)"/>
            <column name="manufacturer" type="VARCHAR(120)"/>
            <column name="model_number" type="VARCHAR(100)"/>
            <column name="serial_number" type="VARCHAR(100)"/>
            <column name="installation_date" type="DATE"/>
            <column name="warranty_expiry_date" type="DATE"/>
            <column name="status" type="VARCHAR(30)" defaultValue="ACTIVE"><constraints nullable="false"/></column>
            <column name="criticality" type="VARCHAR(30)" defaultValue="MEDIUM"><constraints nullable="false"/></column>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP"><constraints nullable="false"/></column>
            <column name="updated_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP"><constraints nullable="false"/></column>
        </createTable>
    </changeSet>

    <changeSet id="cmms-equipment-master-add-site" author="codex">
        <preConditions onFail="MARK_RAN">
            <not><columnExists tableName="equipment_master" columnName="site_id"/></not>
        </preConditions>
        <addColumn tableName="equipment_master">
            <column name="site_id" type="BIGINT"/>
        </addColumn>
    </changeSet>

    <changeSet id="cmms-equipment-master-site-fk" author="codex">
        <preConditions onFail="MARK_RAN">
            <not><foreignKeyConstraintExists foreignKeyName="fk_equipment_site" foreignKeyTableName="equipment_master"/></not>
        </preConditions>
        <addForeignKeyConstraint constraintName="fk_equipment_site" baseTableName="equipment_master" baseColumnNames="site_id" referencedTableName="site_master" referencedColumnNames="site_id"/>
    </changeSet>

    <changeSet id="cmms-equipment-master-indexes" author="codex">
        <preConditions onFail="MARK_RAN">
            <not><indexExists indexName="idx_equipment_master_code"/></not>
        </preConditions>
        <createIndex indexName="idx_equipment_master_code" tableName="equipment_master"><column name="equipment_code"/></createIndex>
        <createIndex indexName="idx_equipment_master_status" tableName="equipment_master"><column name="status"/></createIndex>
        <createIndex indexName="idx_equipment_site_id" tableName="equipment_master"><column name="site_id"/></createIndex>
    </changeSet>
</databaseChangeLog>
