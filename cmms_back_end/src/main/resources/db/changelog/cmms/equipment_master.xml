<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="equipment-001-create-table" author="DARSHAN">
        <createTable tableName="equipment_master">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="equipment_code" type="VARCHAR(50)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="equipment_name" type="VARCHAR(150)">
                <constraints nullable="false"/>
            </column>
            <column name="site_id" type="BIGINT"/>
            <column name="category" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="location" type="VARCHAR(100)"/>
            <column name="manufacturer" type="VARCHAR(120)"/>
            <column name="model_number" type="VARCHAR(100)"/>
            <column name="serial_number" type="VARCHAR(100)"/>
            <column name="installation_date" type="DATE"/>
            <column name="warranty_expiry_date" type="DATE"/>
            <column name="status" type="VARCHAR(30)" defaultValue="ACTIVE">
                <constraints nullable="false"/>
            </column>
            <column name="criticality" type="VARCHAR(30)" defaultValue="MEDIUM">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="equipment-002-add-foreign-keys" author="DARSHAN">
        <addForeignKeyConstraint constraintName="fk_equipment_site"
                                 baseTableName="equipment_master"
                                 baseColumnNames="site_id"
                                 referencedTableName="site_master"
                                 referencedColumnNames="site_id"/>
    </changeSet>

    <changeSet id="equipment-003-create-indexes" author="DARSHAN">
        <createIndex indexName="idx_equipment_master_status" tableName="equipment_master">
            <column name="status"/>
        </createIndex>
        <createIndex indexName="idx_equipment_site_id" tableName="equipment_master">
            <column name="site_id"/>
        </createIndex>
    </changeSet>

    <changeSet id="equipment-004-add-lifecycle-columns" author="DARSHAN">
        <addColumn tableName="equipment_master">
            <column name="commissioning_date" type="DATE"/>
            <column name="decommission_date" type="DATE"/>
            <column name="lifecycle_status" type="VARCHAR(30)" defaultValue="ACTIVE">
                <constraints nullable="false"/>
            </column>
            <column name="asset_condition" type="VARCHAR(30)" defaultValue="GOOD">
                <constraints nullable="false"/>
            </column>
            <column name="operating_status" type="VARCHAR(30)" defaultValue="RUNNING">
                <constraints nullable="false"/>
            </column>
            <column name="ownership_type" type="VARCHAR(30)" defaultValue="OWNED">
                <constraints nullable="false"/>
            </column>
        </addColumn>
    </changeSet>

    <changeSet id="equipment-005-add-lifecycle-indexes" author="DARSHAN">
        <createIndex indexName="idx_equipment_lifecycle_status" tableName="equipment_master">
            <column name="lifecycle_status"/>
        </createIndex>
        <createIndex indexName="idx_equipment_operating_status" tableName="equipment_master">
            <column name="operating_status"/>
        </createIndex>
    </changeSet>

    <changeSet id="equipment-006-add-erp-finance-columns" author="DARSHAN">
        <addColumn tableName="equipment_master">
            <column name="asset_number" type="VARCHAR(80)"/>
            <column name="purchase_date" type="DATE"/>
            <column name="purchase_cost" type="DECIMAL(14,2)"/>
            <column name="capitalization_date" type="DATE"/>
            <column name="depreciation_method" type="VARCHAR(80)"/>
            <column name="cost_center" type="VARCHAR(100)"/>
            <column name="department" type="VARCHAR(100)"/>
        </addColumn>
    </changeSet>

    <changeSet id="equipment-007-add-erp-finance-indexes" author="DARSHAN">
        <createIndex indexName="idx_equipment_asset_number" tableName="equipment_master">
            <column name="asset_number"/>
        </createIndex>
        <createIndex indexName="idx_equipment_cost_center" tableName="equipment_master">
            <column name="cost_center"/>
        </createIndex>
        <createIndex indexName="idx_equipment_department" tableName="equipment_master">
            <column name="department"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>
