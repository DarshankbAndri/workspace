<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="vendor-amc-contract-001-create-table" author="Codex">
        <createTable tableName="vendor_amc_contract">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="vendor_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="site_id" type="BIGINT"/>
            <column name="contract_number" type="VARCHAR(80)">
                <constraints nullable="false"/>
            </column>
            <column name="contract_name" type="VARCHAR(180)">
                <constraints nullable="false"/>
            </column>
            <column name="contract_type" type="VARCHAR(60)"/>
            <column name="start_date" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="end_date" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="contract_value" type="DECIMAL(14,2)"/>
            <column name="coverage_description" type="VARCHAR(1000)"/>
            <column name="response_time_hours" type="INTEGER"/>
            <column name="resolution_time_hours" type="INTEGER"/>
            <column name="includes_labor" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="includes_spares" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="VARCHAR(30)" defaultValue="DRAFT">
                <constraints nullable="false"/>
            </column>
            <column name="contact_person" type="VARCHAR(120)"/>
            <column name="contact_phone" type="VARCHAR(40)"/>
            <column name="contact_email" type="VARCHAR(160)"/>
            <column name="remarks" type="VARCHAR(1000)"/>
            <column name="renewed_from_contract_id" type="BIGINT"/>
            <column name="created_by" type="VARCHAR(120)"/>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_by" type="VARCHAR(120)"/>
            <column name="updated_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addUniqueConstraint tableName="vendor_amc_contract"
                             columnNames="contract_number"
                             constraintName="uk_vendor_amc_contract_number"/>
        <createIndex tableName="vendor_amc_contract" indexName="idx_vendor_amc_vendor">
            <column name="vendor_id"/>
        </createIndex>
        <createIndex tableName="vendor_amc_contract" indexName="idx_vendor_amc_site">
            <column name="site_id"/>
        </createIndex>
        <createIndex tableName="vendor_amc_contract" indexName="idx_vendor_amc_status">
            <column name="status"/>
        </createIndex>
        <createIndex tableName="vendor_amc_contract" indexName="idx_vendor_amc_end_date">
            <column name="end_date"/>
        </createIndex>
        <addForeignKeyConstraint constraintName="fk_vendor_amc_vendor"
                                 baseTableName="vendor_amc_contract"
                                 baseColumnNames="vendor_id"
                                 referencedTableName="vendor_master"
                                 referencedColumnNames="id"/>
        <addForeignKeyConstraint constraintName="fk_vendor_amc_site"
                                 baseTableName="vendor_amc_contract"
                                 baseColumnNames="site_id"
                                 referencedTableName="site_master"
                                 referencedColumnNames="site_id"/>
        <addForeignKeyConstraint constraintName="fk_vendor_amc_renewed_from"
                                 baseTableName="vendor_amc_contract"
                                 baseColumnNames="renewed_from_contract_id"
                                 referencedTableName="vendor_amc_contract"
                                 referencedColumnNames="id"/>
    </changeSet>

    <changeSet id="vendor-amc-contract-002-add-site-existing-schema" author="Codex">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="vendor_amc_contract" columnName="site_id"/>
            </not>
        </preConditions>
        <addColumn tableName="vendor_amc_contract">
            <column name="site_id" type="BIGINT"/>
        </addColumn>
        <createIndex tableName="vendor_amc_contract" indexName="idx_vendor_amc_site">
            <column name="site_id"/>
        </createIndex>
        <addForeignKeyConstraint constraintName="fk_vendor_amc_site"
                                 baseTableName="vendor_amc_contract"
                                 baseColumnNames="site_id"
                                 referencedTableName="site_master"
                                 referencedColumnNames="site_id"/>
    </changeSet>
</databaseChangeLog>
