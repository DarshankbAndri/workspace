<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd" xmlns="http://www.liquibase.org/xml/ns/dbchangelog">
    <changeSet id="notification-001-create-table" author="DARSHAN">
        <createTable tableName="notification">
            <column name="notification_id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false" />
            </column>
            <column name="recipient_user_id" type="BIGINT">
                <constraints nullable="false" />
            </column>
            <column name="site_id" type="BIGINT" />
            <column name="type" type="VARCHAR(60)">
                <constraints nullable="false" />
            </column>
            <column name="title" type="VARCHAR(200)">
                <constraints nullable="false" />
            </column>
            <column name="message" type="VARCHAR(1000)">
                <constraints nullable="false" />
            </column>
            <column name="module_code" type="VARCHAR(100)" />
            <column name="reference_id" type="BIGINT" />
            <column name="reference_code" type="VARCHAR(100)" />
            <column name="target_url" type="VARCHAR(300)" />
            <column name="priority" type="VARCHAR(30)" defaultValue="MEDIUM">
                <constraints nullable="false" />
            </column>
            <column name="status" type="VARCHAR(30)" defaultValue="UNREAD">
                <constraints nullable="false" />
            </column>
            <column name="read_at" type="TIMESTAMP" />
            <column name="email_status" type="VARCHAR(30)" defaultValue="NOT_REQUIRED">
                <constraints nullable="false" />
            </column>
            <column name="sent_email_at" type="TIMESTAMP" />
            <column name="dedupe_key" type="VARCHAR(220)" />
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false" />
            </column>
            <column name="updated_at" type="TIMESTAMP" />
        </createTable>
        <addUniqueConstraint tableName="notification" columnNames="dedupe_key" constraintName="uk_notification_dedupe_key" />
    </changeSet>
    <changeSet id="notification-002-add-foreign-keys" author="DARSHAN">
        <addForeignKeyConstraint constraintName="fk_notification_recipient_user" baseTableName="notification" baseColumnNames="recipient_user_id" referencedTableName="users" referencedColumnNames="id" />
        <addForeignKeyConstraint constraintName="fk_notification_site" baseTableName="notification" baseColumnNames="site_id" referencedTableName="site_master" referencedColumnNames="site_id" />
    </changeSet>
    <changeSet id="notification-003-create-indexes" author="DARSHAN">
        <createIndex indexName="idx_notification_recipient_status" tableName="notification">
            <column name="recipient_user_id" />
            <column name="status" />
        </createIndex>
        <createIndex indexName="idx_notification_created_at" tableName="notification">
            <column name="created_at" />
        </createIndex>
        <createIndex indexName="idx_notification_type" tableName="notification">
            <column name="type" />
        </createIndex>
        <createIndex indexName="idx_notification_reference" tableName="notification">
            <column name="module_code" />
            <column name="reference_id" />
        </createIndex>
    </changeSet>
    <changeSet id="notification-004-seed-permissions" author="DARSHAN">
        <sql>
            INSERT INTO permission_master (permission_code, permission_name, module_name, action_name, status, created_at, updated_at) VALUES
            ('NOTIFICATION_VIEW', 'View Notifications', 'Notification', 'VIEW', 'ACTIVE', NOW(), NOW()),
            ('NOTIFICATION_UPDATE', 'Update Notifications', 'Notification', 'UPDATE', 'ACTIVE', NOW(), NOW())
            ON CONFLICT (permission_code) DO NOTHING;
        </sql>
    </changeSet>
</databaseChangeLog>