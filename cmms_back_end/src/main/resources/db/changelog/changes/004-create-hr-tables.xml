<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="004-create-site-master" author="codex">
        <createTable tableName="site_master">
            <column name="site_id" type="BIGSERIAL"><constraints primaryKey="true"/></column>
            <column name="site_code" type="VARCHAR(50)"><constraints nullable="false" unique="true"/></column>
            <column name="site_name" type="VARCHAR(200)"><constraints nullable="false"/></column>
            <column name="organization_name" type="VARCHAR(200)"/>
            <column name="site_type" type="VARCHAR(100)"/>
            <column name="address_line1" type="VARCHAR(300)"/>
            <column name="address_line2" type="VARCHAR(300)"/>
            <column name="city" type="VARCHAR(100)"/>
            <column name="state" type="VARCHAR(100)"/>
            <column name="country" type="VARCHAR(100)"/>
            <column name="pincode" type="VARCHAR(20)"/>
            <column name="contact_person" type="VARCHAR(100)"/>
            <column name="contact_mobile" type="VARCHAR(20)"/>
            <column name="contact_email" type="VARCHAR(150)"/>
            <column name="latitude" type="NUMERIC(12,8)"/>
            <column name="longitude" type="NUMERIC(12,8)"/>
            <column name="status" type="VARCHAR(20)" defaultValue="ACTIVE"/>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP"/>
            <column name="updated_at" type="TIMESTAMP"/>
        </createTable>
        <createIndex indexName="idx_site_master_code" tableName="site_master"><column name="site_code"/></createIndex>
        <createIndex indexName="idx_site_master_status" tableName="site_master"><column name="status"/></createIndex>
    </changeSet>

    <changeSet id="004-create-employee-master" author="codex">
        <createTable tableName="employee_master">
            <column name="employee_id" type="BIGSERIAL"><constraints primaryKey="true"/></column>
            <column name="employee_code" type="VARCHAR(50)"><constraints nullable="false" unique="true"/></column>
            <column name="first_name" type="VARCHAR(100)"><constraints nullable="false"/></column>
            <column name="last_name" type="VARCHAR(100)"/>
            <column name="mobile_number" type="VARCHAR(20)"><constraints nullable="false"/></column>
            <column name="email" type="VARCHAR(150)"/>
            <column name="gender" type="VARCHAR(20)"/>
            <column name="date_of_birth" type="DATE"/>
            <column name="date_of_joining" type="DATE"/>
            <column name="designation" type="VARCHAR(100)"/>
            <column name="department" type="VARCHAR(100)"/>
            <column name="status" type="VARCHAR(20)" defaultValue="ACTIVE"/>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP"/>
            <column name="updated_at" type="TIMESTAMP"/>
        </createTable>
        <createIndex indexName="idx_employee_master_code" tableName="employee_master"><column name="employee_code"/></createIndex>
        <createIndex indexName="idx_employee_master_status" tableName="employee_master"><column name="status"/></createIndex>
    </changeSet>

    <changeSet id="004-create-employee-site-assignment" author="codex">
        <createTable tableName="employee_site_assignment">
            <column name="assignment_id" type="BIGSERIAL"><constraints primaryKey="true"/></column>
            <column name="employee_id" type="BIGINT"><constraints nullable="false"/></column>
            <column name="site_id" type="BIGINT"><constraints nullable="false"/></column>
            <column name="role_name" type="VARCHAR(100)"><constraints nullable="false"/></column>
            <column name="is_primary_site" type="BOOLEAN" defaultValueBoolean="false"/>
            <column name="effective_from" type="DATE"/>
            <column name="effective_to" type="DATE"/>
            <column name="status" type="VARCHAR(20)" defaultValue="ACTIVE"/>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP"/>
            <column name="updated_at" type="TIMESTAMP"/>
        </createTable>
        <addForeignKeyConstraint constraintName="fk_employee_assignment_employee" baseTableName="employee_site_assignment" baseColumnNames="employee_id" referencedTableName="employee_master" referencedColumnNames="employee_id"/>
        <addForeignKeyConstraint constraintName="fk_employee_assignment_site" baseTableName="employee_site_assignment" baseColumnNames="site_id" referencedTableName="site_master" referencedColumnNames="site_id"/>
        <createIndex indexName="idx_employee_assignment_employee" tableName="employee_site_assignment"><column name="employee_id"/></createIndex>
        <createIndex indexName="idx_employee_assignment_site" tableName="employee_site_assignment"><column name="site_id"/></createIndex>
        <createIndex indexName="idx_employee_assignment_status" tableName="employee_site_assignment"><column name="status"/></createIndex>
    </changeSet>

</databaseChangeLog>
