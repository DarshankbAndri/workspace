<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="008-add-site-to-pm-schedule" author="codex">
        <addColumn tableName="preventive_maintenance_schedule">
            <column name="site_id" type="BIGINT"/>
        </addColumn>
        <addForeignKeyConstraint constraintName="fk_pm_schedule_site"
                                 baseTableName="preventive_maintenance_schedule"
                                 baseColumnNames="site_id"
                                 referencedTableName="site_master"
                                 referencedColumnNames="site_id"/>
        <createIndex indexName="idx_pm_schedule_site" tableName="preventive_maintenance_schedule">
            <column name="site_id"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
