<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="006-add-site-to-equipment" author="codex">
        <addColumn tableName="equipment_master">
            <column name="site_id" type="BIGINT"/>
        </addColumn>
        <addForeignKeyConstraint constraintName="fk_equipment_site"
                                 baseTableName="equipment_master"
                                 baseColumnNames="site_id"
                                 referencedTableName="site_master"
                                 referencedColumnNames="site_id"/>
        <createIndex indexName="idx_equipment_site_id" tableName="equipment_master">
            <column name="site_id"/>
        </createIndex>
    </changeSet>

    <changeSet id="006-add-site-to-maintenance-request" author="codex">
        <addColumn tableName="maintenance_request">
            <column name="site_id" type="BIGINT"/>
        </addColumn>
        <addForeignKeyConstraint constraintName="fk_request_site"
                                 baseTableName="maintenance_request"
                                 baseColumnNames="site_id"
                                 referencedTableName="site_master"
                                 referencedColumnNames="site_id"/>
        <createIndex indexName="idx_request_site_id" tableName="maintenance_request">
            <column name="site_id"/>
        </createIndex>
    </changeSet>

    <changeSet id="006-add-site-to-equipment-downtime" author="codex">
        <addColumn tableName="equipment_downtime">
            <column name="site_id" type="BIGINT"/>
        </addColumn>
        <addForeignKeyConstraint constraintName="fk_downtime_site"
                                 baseTableName="equipment_downtime"
                                 baseColumnNames="site_id"
                                 referencedTableName="site_master"
                                 referencedColumnNames="site_id"/>
        <createIndex indexName="idx_downtime_site_id" tableName="equipment_downtime">
            <column name="site_id"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
