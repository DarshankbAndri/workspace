# Environment Variables
#
# Development defaults live in .env.development.
# Production defaults live in .env.production.
# Put machine-specific or secret overrides in .env.local, .env.development.local,
# or .env.production.local.

# API Configuration
VITE_API_URL=/api
VITE_API_TIMEOUT_MS=120000
VITE_API_PROXY_TARGET=http://localhost:4200
VITE_DEV_PROXY_TIMEOUT_MS=120000
VITE_DEV_SERVER_PORT=3500

# Application Configuration
VITE_APP_NAME=CMMS
VITE_APP_COMPANY=ANDRITZ

# Feature Flags (for future use)
VITE_ENABLE_NOTIFICATIONS=false
VITE_ENABLE_DARK_MODE=false

# Do not commit .env.local files.
