# Production defaults
#
# Keep this as /api when the frontend and backend are served behind the same
# origin/reverse proxy. Override with VITE_API_URL in CI/CD for a separate API
# host, for example: https://api.example.com/api

VITE_API_URL=/api
VITE_API_TIMEOUT_MS=120000

VITE_APP_NAME=CMMS
VITE_APP_COMPANY=ANDRITZ
VITE_ENABLE_NOTIFICATIONS=true
VITE_ENABLE_DARK_MODE=true
