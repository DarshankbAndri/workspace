CMMS_UI_BASE_URL=http://127.0.0.1:6200
CMMS_API_BASE_URL=http://127.0.0.1:6100/api
CMMS_ADMIN_USERNAME=superadmin
CMMS_ADMIN_PASSWORD=

# Required for all test runs; the backend must actually use this dedicated database.
# Start backend with --cmms.approval.enabled=true for the configuration project.
# Scoped users and their passwords are created automatically per test.
E2E_TEST_DATABASE_NAME=cmms_e2e
# The remaining database settings are used only by guarded cleanup/reset.
E2E_DB_HOST=localhost
E2E_DB_PORT=5432
E2E_DB_USER=postgres
E2E_DB_PASSWORD=
E2E_PSQL_PATH=
E2E_ALLOW_DESTRUCTIVE_RESET=false
# Must exactly match E2E_TEST_DATABASE_NAME when running cleanup:e2e.
E2E_CLEANUP_CONFIRM=

# Use msedge on Windows when Playwright Chromium is not installed.
E2E_BROWSER_CHANNEL=
E2E_WORKERS=4
