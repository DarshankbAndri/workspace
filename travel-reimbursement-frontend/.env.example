# Environment Variables - Copy to .env file

# API Configuration
REACT_APP_API_URL=http://localhost:8080/api
REACT_APP_API_TIMEOUT=5000

# Application Configuration
REACT_APP_NAME=Travel Reimbursement System
REACT_APP_COMPANY=ANDRITZ

# Feature Flags (for future use)
REACT_APP_ENABLE_NOTIFICATIONS=false
REACT_APP_ENABLE_DARK_MODE=false

# Note: Create a .env file in project root and copy these variables
# Do NOT commit .env file (it's in .gitignore)
# Only commit .env.example as reference
